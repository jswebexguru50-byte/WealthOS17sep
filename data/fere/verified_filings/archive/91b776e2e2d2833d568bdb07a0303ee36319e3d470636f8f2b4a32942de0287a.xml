 appropriate accounting effects based on such developments as required.</in-capmkt:DisclosureOfNotesOnFinancialResultsExplanatoryTextBlock><in-capmkt:DateOfStartOfReportingPeriod contextRef="FourD">2025-04-01</in-capmkt:DateOfStartOfReportingPeriod><in-capmkt:DateOfEndOfReportingPeriod contextRef="FourD">2025-12-31</in-capmkt:DateOfEndOfReportingPeriod><in-capmkt:WhetherResultsAreAuditedOrUnaudited contextRef="FourD">Unaudited</in-capmkt:WhetherResultsAreAuditedOrUnaudited><in-capmkt:NatureOfReportStandaloneConsolidated contextRef="FourD">Standalone</in-capmkt:NatureOfReportStandaloneConsolidated><in-capmkt:RevenueFromOperations contextRef="FourD" decimals="-4" unitRef="INR">18627150000</in-capmkt:RevenueFromOperations><in-capmkt:OtherIncome contextRef="FourD" decimals="-4" unitRef="INR">376330000</in-capmkt:OtherIncome><in-capmkt:Income contextRef="FourD" decimals="-4" unitRef="INR">19003480000</in-capmkt:Income><in-capmkt:CostOfMaterialsConsumed contextRef="FourD" decimals="-4" unitRef="INR">8342980000</in-capmkt:CostOfMaterialsConsumed><in-capmkt:PurchasesOfStockInTrade contextRef="FourD" decimals="-6" unitRef="INR">0</in-capmkt:PurchasesOfStockInTrade><in-capmkt:ChangesInInventoriesOfFinishedGoodsWorkInProgressAndStockInTrade contextRef="FourD" decimals="-4" unitRef="INR">-385760000</in-capmkt:ChangesInInventoriesOfFinishedGoodsWorkInProgressAndStockInTrade><in-capmkt:EmployeeBenefitExpense contextRef="FourD" decimals="-4" unitRef="INR">1943470000</in-capmkt:EmployeeBenefitExpense><in-capmkt:FinanceCosts contextRef="FourD" decimals="-4" unitRef="INR">40630000</in-capmkt:FinanceCosts><in-capmkt:DepreciationDepletionAndAmortisationExpense contextRef="FourD" decimals="-4" unitRef="INR">551570000</in-capmkt:DepreciationDepletionAndAmortisationExpense><in-capmkt:OtherExpenses contextRef="FourD" decimals="-4" unitRef="INR">2898920000</in-capmkt:OtherExpenses><in-capmkt:Expenses contextRef="FourD" decimals="-4" unitRef="INR">13391810000</in-capmkt:Expenses><in-capmkt:P