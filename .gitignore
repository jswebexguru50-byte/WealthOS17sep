# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Large data files — on disk but not in git
*.parquet
*.feather
*.pkl
*.h5
*.hdf5

# Databases — on disk but not in git (fere_evidence.db too)
*.db
*.db-wal
*.db-shm

# Build outputs
node_modules/
dist/
__pycache__/
*.pyc
.pytest_cache/

# AI tool caches
.adal/
.agents/
.archify/

# Logs and temp
*.log
*.tmp

# Backup snapshots
portfolio_persistent_backup*
scripts/qa/out/
reports/
tests/reports/
git_log_all.txt

# Local archived snapshots and compatibility links (not source)
/WealthOS04Oct
/WealthOS-filter-overview
/node_modules
# Local diagnostic scripts belong in scripts/ or the external archive
/inspect_*.cjs
/check_*.cjs
/debug_*.cjs
/find_*.cjs
/query_*.cjs
/list_*.cjs
/trace_*.cjs
/compare_*.cjs
