{
  "name": "portfolio-tracker",
  "private": true,
  "version": "1.0.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development NODE_USE_SYSTEM_CA=1 NODE_OPTIONS=--require=./scripts/node_userinfo_fallback.cjs tsx server.ts",
    "dev:research": "cross-env NODE_ENV=development NODE_OPTIONS=--require=./scripts/node_userinfo_fallback.cjs tsx server.research.ts",
    "sync:schema": "tsx scripts/export_empty_schema_sql.ts",
    "sync": "cmd /c sync_and_push.bat",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "test": "tsx scripts/run_tests.ts",
    "test:unit": "cross-env NODE_OPTIONS=--experimental-vm-modules jest unit --runInBand",
    "test:integration": "cross-env NODE_OPTIONS=--experimental-vm-modules jest integration --runInBand",
    "test:negative": "cross-env NODE_OPTIONS=--experimental-vm-modules jest negative --runInBand",
    "test:performance": "cross-env NODE_OPTIONS=--experimental-vm-modules jest performance --runInBand",
    "test:e2e": "tsx scratch/test_e2e_autonomous_system.ts",
    "test:full": "npm run test:unit && npm run test:integration && npm run test:negative && npm run test:performance && npm run test:e2e",
    "electron:start": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder --win",
    "clean": "rm -rf dist server.js dist_electron",
    "lint": "tsc --noEmit",
    "wealthos:test": "node tests/run-all-tests.mjs",
    "wealthos:test:unit": "npx vitest run tests/unit --reporter=verbose",
    "wealthos:test:integration": "npx vitest run tests/integration --reporter=verbose",
    "wealthos:test:e2e": "npx playwright test tests/e2e/",
    "wealthos:test:static": "node tests/static-analysis/hardcoded-audit.mjs",
    "wealthos:test:fast": "node tests/run-all-tests.mjs --skip-e2e",
    "wealthos:test:coverage": "npx vitest run tests/unit tests/integration --coverage",
    "r1:fingerprint": "node scripts/fingerprint_v6.2_baseline.mjs",
    "r1:gate": "node scripts/run_r1_gate.mjs",
    "r1:test": "vitest run tests/unit/point_in_time_data_integrity.test.ts tests/integration/r1_integrated_fixture.test.ts --reporter=verbose",
    "v63:e2e": "node scripts/run_v6.3_e2e.mjs",
    "v63:research": "npx tsx scripts/execute_full_v6.3_research_pipeline.mjs",
    "v63:typecheck": "tsc --noEmit",
    "chatgpt:export-schema": "node scripts/export_schema_and_sample.mjs",
    "chatgpt-review": "node scripts/chatgpt-review.js",
    "chatgpt-review:focused": "node scripts/chatgpt-review.js --focused",
    "verify:v672-r2": "tsx scripts/v672/run_v672_r2_master_verification.ts",
    "ai-review": "tsx tools/ai-review-server/src/server.ts",
    "ai-review:tunnel": "powershell -ExecutionPolicy Bypass -File tools/ai-review-server/start-review-portal.ps1",
    "fundamental:filters": "tsx scripts/fundamental/run_filter_enrichment_daemon.ts",
    "fundamental:priority": "tsx scripts/fundamental/build_priority_manifest.ts",
    "fundamental:upstox": "cross-env NODE_OPTIONS=\"--require=./scripts/node_userinfo_fallback.cjs --use-system-ca\" tsx scripts/fundamental/run_upstox_fundamental_enrichment.ts",
    "fundamental:pipeline": "tsx scripts/fundamental/run_fundamental_pipeline.ts",
    "fundamental:sync": "python scripts/fundamental/sync_verified_fundamentals_package.py",
    "fundamental:dossier": "node scripts/fundamental/build_selected_fundamental_dossier.mjs",
    "fundamental:deep": "node scripts/fundamental/build_deep_fundamental_report.mjs",
    "fundamental:institutional29": "node scripts/fundamental/institutional29/build_bundle.mjs",
    "fundamental:institutional29:test": "node --test scripts/fundamental/institutional29/*.test.mjs",
    "fundamental:institutional29:validate": "node scripts/fundamental/institutional29/validate_report.mjs",
    "fundamental:institutional29:split": "node scripts/fundamental/institutional29/split_comparative_report.mjs",
    "fundamental:institutional29:persist": "node scripts/fundamental/institutional29/persist_analysis.mjs",
    "fundamental:institutional29:onhand": "tsx scripts/fundamental/institutional29/run_onhand_batch.ts",
    "fundamental:institutional29:onhand:synthesize": "tsx scripts/fundamental/institutional29/synthesize_onhand_existing.ts",
    "dossier:combined": "python scripts/fundamental/merge_technical_fundamental_dossiers.py",
    "strategy:scan:30d": "cross-env NODE_OPTIONS=--require=./scripts/node_userinfo_fallback.cjs tsx scripts/strategy/run_30d_alphanumeric_dossier.ts",
    "fundamental:qglp": "cross-env NODE_OPTIONS=--require=./scripts/node_userinfo_fallback.cjs tsx scripts/fundamental/run_qglp_enrichment_daemon.ts",
    "fundamental:trendlyne": "cross-env NODE_OPTIONS=\"--use-system-ca --require=./scripts/node_userinfo_fallback.cjs\" tsx scripts/fundamental/run_trendlyne_mcp_enrichment.ts",
    "fundamental:trendlyne:audit": "cross-env NODE_OPTIONS=--require=./scripts/node_userinfo_fallback.cjs tsx scripts/fundamental/audit_trendlyne_coverage.ts",
    "intelligence:acceptance": "vitest run tests/unit/master_acceptance_suite.test.ts",
    "mcp:stdio": "cross-env NODE_OPTIONS=--require=./scripts/node_userinfo_fallback.cjs tsx src/mcp/transports/stdio.ts",
    "mcp:http": "cross-env NODE_OPTIONS=--require=./scripts/node_userinfo_fallback.cjs tsx src/mcp/transports/http.ts",
    "mcp:test": "vitest run tests/unit/wealthos_universal_mcp.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1128.0",
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@google/genai": "^2.4.0",
    "@google/generative-ai": "^0.24.1",
    "@libsql/client": "^0.14.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@react-oauth/google": "^0.13.5",
    "@tailwindcss/vite": "^4.1.14",
    "@types/compression": "^1.8.1",
    "@types/nodemailer": "^8.0.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "adm-zip": "^0.6.0",
    "archiver": "^8.0.0",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "compression": "^1.8.1",
    "csv-parse": "^7.0.1",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.11.1",
    "firebase": "^12.16.0",
    "kiteconnect": "^5.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "node-fetch": "^3.3.2",
    "node-html-parser": "^9.0.1",
    "nodemailer": "^10.0.10",
    "playwright": "^1.62.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.9.2",
    "rss-parser": "^3.13.0",
    "sqlite3": "5.1.7",
    "string-similarity": "^4.0.4",
    "technicalindicators": "^3.1.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "ws": "^8.21.3",
    "xlsx": "^0.18.5",
    "youtube-transcript": "^1.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^8.0.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "axios": "^1.20.0",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "jest": "^30.5.1",
    "jest-junit": "^17.0.0",
    "pdf-parse": "^2.4.5",
    "puppeteer": "^25.7.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "ts-jest": "^29.4.12",
    "vite": "^6.2.3",
    "vitest": "^5.0.0",
    "wait-on": "^9.1.0",
    "yahoo-finance2": "^4.0.2"
  }
}
